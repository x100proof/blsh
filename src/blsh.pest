WHITESPACE  = _{ " " | "\t" | "\r" | "\n" }

program     =  { SOI ~ statement ~ EOI }

statement   =  { let_stmt | command_stmt | expr }

let_stmt    =  { "let" ~ ident ~ "=" ~ expr }
command_stmt = { "info" ~ expr }

expr        = { eq_expr ~ (eq_op ~ eq_expr)* }
eq_expr     = { mul_expr ~ (add_op ~ mul_expr)* }
add_op      = { "+" | "-" }
eq_op       = { "==" }

mul_expr    =  { neg_expr ~ ("*" ~ neg_expr)* }

neg_expr = { "-" ~ neg_expr | /*"-p-" ~ neg_expr | "-e1-" ~ neg_expr | "-e2-"  ~ neg_expr |*/ primary }

// Order is important here.
// Put all rules for "reserved words" first
primary     =  {
    | bool
    | sqrt // must come before sqr otherwise "sqr" gets consumed first
    | sqr
    | pow
    | miller_loop
    | inv
    | map_to_g1
    | map_to_g2
    | embed
    | point
    | compressed_point1
    | uncompressed_point1
    | compressed_point2
    | uncompressed_point2
    | scalar
    | coord1
    | coord_pair
    | coord_triple
    | coord_flat6
    | coord_flat12
    | list_expr
    | ident
    | "(" ~ expr ~ ")"

}

// We disambiguate between Point1 and Point2 in the parser
point               = { "<" ~ expr ~ "," ~ expr ~ ">" }

// all coord_<x> variants could be Coord1, Coord2, Coord6, or Coord12. We disambiguate in the parser
coord_pair          = { cbo ~ expr ~ "," ~ expr ~ cbc }
coord_triple        = { cbo ~ expr ~ "," ~ expr ~ "," ~ expr ~ cbc }

coord_flat6         = { cbo ~ expr ~ "," ~ expr ~ "," ~ expr ~ "," ~ expr ~ "," ~ expr ~ "," ~ expr ~ cbc }
coord_flat12        = { cbo ~ expr ~ "," ~ expr ~ "," ~ expr ~ "," ~ expr ~ "," ~ expr ~ "," ~ expr ~ "," ~ expr ~ "," ~ expr ~ "," ~ expr ~ "," ~ expr ~ "," ~ expr ~ "," ~ expr ~ cbc }

// coord brace open & close
cbo                  = _{ "(" | "{" }
cbc                  = _{ ")" | "}" }


// We unconstrain hex digit length and handle error in parser for better error messages
scalar              = ${ dec_or_hex ~ sep? ~ S }
coord1              = { dec_or_hex }
compressed_point1   = ${ hex ~ sep? ~ P1 }
uncompressed_point1 = ${ hex ~ sep? ~ U1 }
compressed_point2   = ${ hex ~ sep? ~ P2 }
uncompressed_point2 = ${ hex ~ sep? ~ U2 }

sep = _{ ":" | "|" }
S =  _{ "s" }
P1 = _{ "p1" }
U1 = _{ "u1" }
P2 = _{ "p2" }
U2 = _{ "u2" }

dec_or_hex = _{ hex | dec }
dec        = @{ ASCII_DIGIT+ }
hex   = @{ "0x" ~ ASCII_HEX_DIGIT+ }

sqrt  = { "sqrt" ~ "(" ~ expr ~ ")" }
sqr   = { "sqr"  ~ "(" ~ expr ~ ")" } // just for Coord12
pow   = { "pow"  ~ "(" ~ expr ~ "," ~ expr ~ ")" }
inv   = { "inv"  ~ "(" ~ expr ~ ")" } // just for Coord12
miller_loop = { "miller_loop" ~ "(" ~ expr ~ ")"}

map_to_g1 = { "map_to_g1" ~ "(" ~ expr ~ "," ~ expr ~ ")" }
map_to_g2 = { "map_to_g2" ~ "(" ~ expr ~ "," ~ expr ~ ")" }
embed = { "embed" ~ "(" ~ expr ~ "," ~ expr ~ ")" }

ident       =  @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }

bool        = @{ "true" | "false" }

list_expr = { "[" ~ expr ~ ( "," ~ expr )* ~ "]" }